{
  "expo": {
    "name": "Lumora",
    "slug": "Lumora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lumora-icon-1024.png",
    "scheme": "lumora",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/lumora-mark-transparent-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8FF"
    },
    "ios": {
      "icon": "./assets/images/lumora-icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8FF",
        "foregroundImage": "./assets/images/lumora-adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lumora-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8FF",
          "image": "./assets/images/lumora-mark-transparent-1024.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
