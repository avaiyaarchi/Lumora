{
  "expo": {
    "name": "Lumora",
    "slug": "Lumora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lumora-icon-1024.png",
    "scheme": "lumora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lumora-icon-1024.png"
    },
    "android": {
      "package": "com.lumora.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAF8FF",
        "foregroundImage": "./assets/images/lumora-adaptive-icon-foreground.png"
      },
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lumora-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8FF",
          "image": "./assets/images/lumora-mark-transparent-1024.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/lumora-adaptive-icon-foreground.png",
          "color": "#8B5CF6"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e687f76-3d34-4278-809e-282f458e3019"
      }
    }
  }
}
